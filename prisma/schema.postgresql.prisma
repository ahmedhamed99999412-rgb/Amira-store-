// ============================================================
// AMIRA STORE - Prisma Schema
// ============================================================
// Designed for SQLite (dev) and PostgreSQL (production / Neon).
// To switch to PostgreSQL: change provider to "postgresql" and run migrations.
// All images are stored as Base64 strings inside the database.
// Enums are modeled as String for cross-database compatibility.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. USER & AUTH
// ============================================================

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  phone        String   @unique
  fullName     String?
  passwordHash String
  role         String   @default("CUSTOMER") // CUSTOMER | ADMIN
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses Address[]
  carts     Cart[]
  wishlists Wishlist[]
  orders    Order[]
  reviews   Review[]

  @@map("users")
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  fullName    String
  phone       String
  street      String
  city        String
  governorate String
  landmarks   String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ============================================================
// 2. CATEGORIES (tree structure with translations)
// ============================================================

model Category {
  id        String   @id @default(cuid())
  parentId  String?
  slug      String   @unique
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent       Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]          @relation("CategoryTree")
  translations CategoryTranslation[]
  image        CategoryImage?
  products     Product[]

  @@index([parentId])
  @@map("categories")
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  locale      String // "ar" | "en"
  name        String
  description String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@map("category_translations")
}

model CategoryImage {
  id         String   @id @default(cuid())
  categoryId String   @unique
  base64Data String
  mimeType   String
  fileSize   Int
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("category_images")
}

// ============================================================
// 3. PRODUCTS (with translations, images, variants, tags, related)
// ============================================================

model Product {
  id           String    @id @default(cuid())
  categoryId   String
  slug         String    @unique
  sku          String    @unique
  price        Float
  comparePrice Float?
  costPrice    Float?
  hasVariants  Boolean   @default(false)
  isActive     Boolean   @default(true)
  isFeatured   Boolean   @default(false)
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  translations ProductTranslation[]
  images       ProductImage[]
  variants     ProductVariant[]
  tags         ProductTag[]
  reviews      Review[]
  cartItems    CartItem[]
  wishlistItems WishlistItem[]
  orderItems   OrderItem[]
  relatedAsMain    RelatedProduct[] @relation("ProductToRelated")
  relatedAsRelated RelatedProduct[] @relation("RelatedToProduct")

  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([isDeleted])
  @@map("products")
}

model ProductTranslation {
  id               String  @id @default(cuid())
  productId        String
  locale           String // "ar" | "en"
  name             String
  shortDescription String?
  description      String?
  metaTitle        String?
  metaDescription  String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@map("product_translations")
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  base64Data String
  mimeType   String
  fileSize   Int
  width      Int?
  height     Int?
  altAr      String?
  altEn      String?
  order      Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  size            String?
  color           String?
  colorHex        String?
  stock           Int      @default(0)
  sku             String?
  priceAdjustment Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductTag {
  id        String @id @default(cuid())
  productId String
  locale    String // "ar" | "en"
  tag       String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale, tag])
  @@map("product_tags")
}

model RelatedProduct {
  id               String   @id @default(cuid())
  productId        String
  relatedProductId String
  suggestedByAI    Boolean  @default(false)
  isApproved       Boolean  @default(false)
  reason           String?
  createdAt        DateTime @default(now())

  product        Product @relation("ProductToRelated", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("RelatedToProduct", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId])
  @@map("related_products")
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String?
  guestName  String
  guestPhone String?
  rating     Int // 1-5
  title      String?
  comment    String?
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("reviews")
}

// ============================================================
// 4. CART & WISHLIST (support both user and guest)
// ============================================================

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  guestId   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@unique([userId])
  @@unique([guestId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

model Wishlist {
  id        String          @id @default(cuid())
  userId    String?
  guestId   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user  User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@unique([userId])
  @@unique([guestId])
  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// ============================================================
// 5. ORDERS (with snapshot of product data)
// ============================================================

model Order {
  id             String   @id @default(cuid())
  orderNumber    String   @unique
  idempotencyKey  String?  @unique
  userId         String?
  guestName      String
  guestPhone     String
  guestAddress   String
  governorate    String
  city           String
  landmarks      String?
  guestNotes     String?
  subtotal       Float
  shippingCost   Float?
  shippingStatus String   @default("MANUAL") // MANUAL | FREE
  discount       Float    @default(0)
  couponCode     String?
  total          Float
  status         String   @default("PENDING_CONFIRMATION") // PENDING_CONFIRMATION | CONFIRMED | SHIPPING | DELIVERED | CANCELLED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([guestPhone])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  variantId     String?
  productNameAr String
  productNameEn String
  productSku    String
  productPrice  Float
  quantity      Int
  productImage  String // Base64 snapshot of primary image
  stockAllocation String? // JSON array of { variantId, quantity } reserved at order creation

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// ============================================================
// 6. COUPONS
// ============================================================

model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  type       String // PERCENTAGE | FIXED
  value      Float
  minOrder   Float?
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  usageLimit Int?
  usedCount  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("coupons")
}

// ============================================================
// 7. BANNERS (Hero + Promo)
// ============================================================

model Banner {
  id          String   @id @default(cuid())
  type        String // HERO | PROMO | ANNOUNCEMENT
  base64Data  String
  mimeType    String
  fileSize    Int      @default(0)
  titleAr     String?
  titleEn     String?
  subtitleAr  String?
  subtitleEn  String?
  ctaTextAr   String?
  ctaTextEn   String?
  ctaLink     String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@map("banners")
}

// ============================================================
// 8. STORE SETTINGS (singleton - editable from admin)
// ============================================================

model StoreSettings {
  id                   String   @id @default("singleton")
  whatsappNumber       String
  instagramUrl         String?
  facebookUrl          String?
  storeNameAr          String
  storeNameEn          String
  email                String?
  addressAr            String?
  addressEn            String?
  currency             String   @default("EGP")
  freeShippingEnabled  Boolean  @default(false)
  freeShippingMinOrder Float?
  freeShippingStart    DateTime?
  freeShippingEnd      DateTime?
  announcementAr       String
  announcementEn       String
  updatedAt            DateTime @updatedAt

  @@map("store_settings")
}
