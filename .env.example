# ============================================
# AMIRA STORE - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# For production (Vercel + Neon), set these in your Vercel project settings

# ---- DATABASE ----
# Local development (SQLite):
DATABASE_URL="file:../database/custom.db"
# Production (Neon PostgreSQL):
# DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ---- AUTHENTICATION ----
# JWT secret for session tokens (use a strong random string in production)
# Generate with: openssl rand -hex 32
JWT_SECRET=""
# JWT token expiry (e.g., 7d, 30d, 1y)
JWT_EXPIRES_IN="7d"

# ---- APP ----
# Public URL of your app (used for SEO, OpenGraph, etc.)
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- ADMIN CREDENTIALS (used by seed script) ----
# Only set to true for an intentional production database reset using prisma/seed.ts
ALLOW_DESTRUCTIVE_SEED="false"
# These create the initial admin user when running `npm run db:seed`
ADMIN_USERNAME="admin"
ADMIN_PHONE="01019003677"
ADMIN_PASSWORD="CHANGE_ME_BEFORE_FIRST_SEED"

# ---- STORE (used by seed script) ----
STORE_WHATSAPP_NUMBER="01019003677"

# ---- AI (OpenAI-compatible provider) ----
# The AI features (translation, description generation, variant suggestions, chat widget)
# use an OpenAI-compatible API provider. This is the production-safe configuration.
#
# Supported providers:
#   - OpenAI: set OPENAI_API_KEY and optionally OPENAI_BASE_URL / OPENAI_MODEL
#   - Z.ai: set ZAI_API_KEY and optionally ZAI_BASE_URL / ZAI_MODEL
#
# Example values:
# OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"
#
# ZAI_API_KEY=""
# ZAI_BASE_URL="https://api.z.ai/v1"
# ZAI_MODEL="glm-4.5"
#
# If neither provider key is set, all AI endpoints return HTTP 503 with a clear error.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
ZAI_API_KEY=""
ZAI_BASE_URL="https://api.z.ai/v1"
ZAI_MODEL="glm-4.5"
