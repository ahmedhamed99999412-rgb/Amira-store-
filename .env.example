# ============================================
# AMIRA STORE - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# For production (Vercel + Neon), set these in your Vercel project settings

# ---- DATABASE ----
# Local development (SQLite):
DATABASE_URL="file:../database/custom.db"
# Production (Neon PostgreSQL):
# DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ---- AUTHENTICATION ----
# JWT secret for session tokens (use a strong random string in production)
# Generate with: openssl rand -hex 32
JWT_SECRET=""
# JWT token expiry (e.g., 7d, 30d, 1y)
JWT_EXPIRES_IN="7d"

# ---- APP ----
# Public URL of your app (used for SEO, OpenGraph, etc.)
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- ADMIN CREDENTIALS (used by seed script) ----
# Only set to true for an intentional production database reset using prisma/seed.ts
ALLOW_DESTRUCTIVE_SEED="false"
# These create the initial admin user when running `npm run db:seed`
ADMIN_USERNAME="admin"
ADMIN_PHONE="01019003677"
ADMIN_PASSWORD="CHANGE_ME_BEFORE_FIRST_SEED"

# ---- STORE (used by seed script) ----
STORE_WHATSAPP_NUMBER="01019003677"

# ---- AI (Z.ai SDK) ----
# The AI features (translation, description generation, variant suggestions, chat widget)
# use the z-ai-web-dev-sdk which requires a .z-ai-config file.
#
# IMPORTANT: In the current Z.ai environment, the config is at /etc/.z-ai-config
# and points to an INTERNAL Z.ai API (https://internal-api.z.ai/v1).
# This API is NOT publicly available outside the Z.ai environment.
#
# To use AI features in production, you have two options:
#
# Option A: Replace z-ai-web-dev-sdk with OpenAI/Anthropic/etc.
#   - Update src/lib/ai.ts to use your preferred AI provider
#   - Set OPENAI_API_KEY or ANTHROPIC_API_KEY
#
# Option B: Use Z.ai API if you have access (requires Z.ai account)
#   - Create a .z-ai-config file in project root with:
#     {"baseUrl":"https://api.z.ai/v1","apiKey":"YOUR_ZAI_API_KEY"}
#   - See: https://z.ai for API access
#
# ZAI_API_KEY=""  # Only if using Z.ai API directly
# OPENAI_API_KEY=""  # Alternative AI provider
